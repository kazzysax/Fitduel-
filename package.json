{
  "name": "fitduel",
  "version": "0.1.0",
  "private": true,
  "description": "Fitness app where your training powers an AI champion that fights in Duels and Rumbles.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --test \"engine/test/*.test.ts\" \"server/test/*.test.ts\"",
    "demo": "node engine/demo.ts",
    "server": "node --disable-warning=ExperimentalWarning server/main.ts",
    "dev": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "start": "npm run build && npm run server"
  }
}
